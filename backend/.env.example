HOST=127.0.0.1
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
# Development defaults to SQLite. Set PostgreSQL URL after installing pg.
DATABASE_URL=
DATA_DIR=./data
# First admin created only through CLI with these temporary environment variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Enable when served over HTTPS.
COOKIE_SECURE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Your adapter must implement POST /script and POST /voice; see API.md.
AI_ADAPTER_URL=
AI_ADAPTER_TOKEN=
# Optional direct SMS OTP provider. Keep empty until owner configures a real service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional direct cloud speech provider (replaces generic voice adapter when configured).
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
